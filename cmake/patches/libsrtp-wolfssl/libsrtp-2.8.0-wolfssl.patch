--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -84,16 +84,17 @@ set(ERR_REPORTING_FILE "" CACHE FILEPATH "Use file for logging")
 set(ENABLE_OPENSSL OFF CACHE BOOL "Enable OpenSSL crypto engine")
 set(ENABLE_MBEDTLS OFF CACHE BOOL "Enable MbedTLS crypto engine")
 set(ENABLE_NSS OFF CACHE BOOL "Enable NSS crypto engine")
+set(ENABLE_WOLFSSL OFF CACHE BOOL "Enable wolfCrypt AES-GCM crypto engine")
 
-if(ENABLE_OPENSSL OR ENABLE_MBEDTLS OR ENABLE_NSS)
+if(ENABLE_OPENSSL OR ENABLE_MBEDTLS OR ENABLE_NSS OR ENABLE_WOLFSSL)
   set(USE_EXTERNAL_CRYPTO TRUE)
 else()
   set(USE_EXTERNAL_CRYPTO FALSE)
 endif()
 
 if(ENABLE_OPENSSL)
-  if(ENABLE_NSS OR ENABLE_MBEDTLS)
-    message(FATAL_ERROR "ssl conflict. can not enable openssl and mbedtls or nss simultaneously.")
+  if(ENABLE_NSS OR ENABLE_MBEDTLS OR ENABLE_WOLFSSL)
+    message(FATAL_ERROR "crypto conflict: select exactly one external crypto engine.")
   endif()
   find_package(OpenSSL 1.1.0 REQUIRED)
   set(OPENSSL ${ENABLE_OPENSSL} CACHE BOOL INTERNAL)
@@ -101,8 +102,8 @@ if(ENABLE_OPENSSL)
 endif()
 
 if(ENABLE_MBEDTLS)
-  if(ENABLE_OPENSSL OR ENABLE_NSS)
-    message(FATAL_ERROR "ssl conflict. can not enable mbedtls and openssl or nss simultaneously.")
+  if(ENABLE_OPENSSL OR ENABLE_NSS OR ENABLE_WOLFSSL)
+    message(FATAL_ERROR "crypto conflict: select exactly one external crypto engine.")
   endif()
   find_package(MbedTLS REQUIRED)
   set(MBEDTLS ${ENABLE_MBEDTLS} CACHE BOOL INTERNAL)
@@ -110,14 +111,25 @@ if(ENABLE_MBEDTLS)
 endif()
 
 if(ENABLE_NSS)
-  if(ENABLE_OPENSSL OR ENABLE_MBEDTLS)
-    message(FATAL_ERROR "ssl conflict. can not enable nss and openssl or mbedtls simultaneously.")
+  if(ENABLE_OPENSSL OR ENABLE_MBEDTLS OR ENABLE_WOLFSSL)
+    message(FATAL_ERROR "crypto conflict: select exactly one external crypto engine.")
   endif()
   find_package(NSS REQUIRED)
   set(NSS ${ENABLE_NSS} CACHE BOOL INTERNAL)
   set(GCM ${ENABLE_NSS} CACHE BOOL INTERNAL)
 endif()
 
+if(ENABLE_WOLFSSL)
+  if(ENABLE_OPENSSL OR ENABLE_MBEDTLS OR ENABLE_NSS)
+    message(FATAL_ERROR "crypto conflict: select exactly one external crypto engine.")
+  endif()
+  if(NOT TARGET wolfssl::wolfssl)
+    find_package(wolfssl CONFIG REQUIRED)
+  endif()
+  set(WOLFSSL ${ENABLE_WOLFSSL} CACHE BOOL INTERNAL)
+  set(GCM ${ENABLE_WOLFSSL} CACHE BOOL INTERNAL)
+endif()
+
 set(CONFIG_FILE_DIR ${CMAKE_CURRENT_BINARY_DIR})
 include_directories(${CONFIG_FILE_DIR})
 
@@ -159,6 +171,11 @@ elseif(ENABLE_NSS)
     crypto/cipher/aes_icm_nss.c
     crypto/cipher/aes_gcm_nss.c
   )
+elseif(ENABLE_WOLFSSL)
+  list(APPEND CIPHERS_SOURCES_C
+    crypto/cipher/aes_icm_wolfssl.c
+    crypto/cipher/aes_gcm_wolfssl.c
+  )
 else()
   list(APPEND CIPHERS_SOURCES_C
     crypto/cipher/aes.c
@@ -185,6 +202,11 @@ elseif(ENABLE_NSS)
   list(APPEND HASHES_SOURCES_C
     crypto/hash/hmac_nss.c
   )
+elseif(ENABLE_WOLFSSL)
+  list(APPEND HASHES_SOURCES_C
+    crypto/hash/hmac.c
+    crypto/hash/sha1.c
+  )
 else()
   list(APPEND HASHES_SOURCES_C
     crypto/hash/hmac.c
@@ -292,6 +314,11 @@ elseif(ENABLE_MBEDTLS)
 elseif(ENABLE_NSS)
   target_include_directories(srtp2 PRIVATE ${NSS_INCLUDE_DIRS})
   target_link_libraries(srtp2 ${NSS_LIBRARIES})
+elseif(ENABLE_WOLFSSL)
+  target_link_libraries(srtp2 $<BUILD_INTERFACE:wolfssl::wolfssl>)
+  if(APPLE)
+    target_link_libraries(srtp2 "-framework Security" "-framework CoreFoundation")
+  endif()
 endif()
 if(WIN32)
   target_link_libraries(srtp2 ws2_32)
