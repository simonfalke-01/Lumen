<CPackWiXPatch>
  <CPackWiXFragment Id="CM_G_Core">
    <FeatureRef Id="RunLumenInstallScripts"/>
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_C_virtual_hid_driver">
    <Level Value="0" Condition="NOT Installed AND LUMEN_INSTALL_VHID = 0"/>
    <Level Value="1" Condition="LUMEN_INSTALL_VHID = 1"/>
  </CPackWiXFragment>
  <CPackWiXFragment Id="CM_CP_application.tools.lumensvc.exe">
    <ServiceInstall Id="InstallLumenService"
                    Name="LumenService"
                    DisplayName="Lumen Service"
                    Description="Lumen is a self-hosted game stream host for Moonlight."
                    Type="ownProcess"
                    Start="demand"
                    ErrorControl="normal"
                    Account="LocalSystem"
                    Vital="yes"/>
    <ServiceControl Id="ControlLumenService"
                    Name="LumenService"
                    Start="install"
                    Stop="both"
                    Remove="uninstall"
                    Wait="yes"/>
  </CPackWiXFragment>
</CPackWiXPatch>
