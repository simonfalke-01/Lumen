<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <Binary Id="LumenMsiCA" SourceFile="@LUMEN_MSICA_BINARY_WIX@"/>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcutRoot" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcutRoot"
                  Name="Lumen"
                  Description="Lumen Game Stream Host"
                  Target="[INSTALL_ROOT]Lumen.exe"
                  Arguments="--shortcut"
                  WorkingDirectory="INSTALL_ROOT"/>
        <RegistryValue Root="HKCU" Key="Software\simonfalke\Lumen" Name="installed_root" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <Directory Id="ProgramMenuSubfolder" Name="Lumen">
        <Directory Id="ProgramMenuLumenFolder" Name="Lumen">
          <Component Id="ApplicationShortcut" Guid="*">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="Lumen"
                      Description="Lumen Game Stream Host"
                      Target="[INSTALL_ROOT]Lumen.exe"
                      Arguments="--shortcut"
                      WorkingDirectory="INSTALL_ROOT"/>
            <RemoveFolder Id="CleanUpShortCut" Directory="ProgramMenuLumenFolder" On="uninstall"/>
            <RemoveFolder Id="CleanUpShortCutParent" Directory="ProgramMenuSubfolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\simonfalke\Lumen" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="DocumentationShortcut" Guid="*">
            <util:InternetShortcut Id="DocumentationLink"
                                   Name="Lumen on GitHub"
                                   Target="https://github.com/simonfalke-01/Lumen"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpDocsShortCut" Directory="ProgramMenuLumenFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\simonfalke\Lumen" Name="docs_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="WebsiteShortcut" Guid="*">
            <util:InternetShortcut Id="WebsiteLink"
                                   Name="Lumen Releases"
                                   Target="https://github.com/simonfalke-01/Lumen/releases"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpWebsiteShortCut" Directory="ProgramMenuLumenFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\simonfalke\Lumen" Name="website_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="SupportShortcut" Guid="*">
            <util:InternetShortcut Id="SupportLink"
                                   Name="Lumen Support"
                                   Target="https://github.com/simonfalke-01/Lumen/issues"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpSupportShortCut" Directory="ProgramMenuLumenFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\simonfalke\Lumen" Name="support_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Property Id="LUMEN_INSTALL_VHID" Value="0" Secure="yes"/>
    <Property Id="LUMEN_INSTALL_VMIC" Value="0" Secure="yes"/>
    <Property Id="LUMEN_INSTALL_VDD" Value="@LUMEN_INSTALL_VDD_DEFAULT@" Secure="yes"/>
    <Property Id="LUMEN_REMOVE_VDD" Value="0" Secure="yes"/>
    <Property Id="LUMEN_UPGRADE_OWNED_VDD" Value="0" Secure="yes"/>
    <Property Id="LUMEN_DRIVER_REBOOT_REQUIRED" Value="0" Secure="yes"/>

    <!-- Normalize the public silent-install property to the actual feature
         action/current state before building deferred CustomActionData. -->
    <!-- LUMEN_VHID_FEATURE_START -->
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidSelected"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_hid_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidDeselected"
                 Value="0" After="ResolveLumenVhidSelected" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_hid_driver &lt;&gt; 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidInstalled"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_hid_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidNotInstalled"
                 Value="0" After="ResolveLumenVhidInstalled" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_hid_driver &lt;&gt; 3"/>
    <!-- LUMEN_VHID_FEATURE_END -->

    <!-- LUMEN_VMIC_FEATURE_START -->
    <SetProperty Id="LUMEN_INSTALL_VMIC"
                 Action="ResolveLumenVmicSelected"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_microphone_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VMIC"
                 Action="ResolveLumenVmicDeselected"
                 Value="0" After="ResolveLumenVmicSelected" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_microphone_driver &lt;&gt; 3"/>
    <SetProperty Id="LUMEN_INSTALL_VMIC"
                 Action="ResolveLumenVmicInstalled"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_microphone_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VMIC"
                 Action="ResolveLumenVmicNotInstalled"
                 Value="0" After="ResolveLumenVmicInstalled" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_microphone_driver &lt;&gt; 3"/>
    <!-- LUMEN_VMIC_FEATURE_END -->

    <!-- LUMEN_VDD_FEATURE_START -->
    <SetProperty Id="LUMEN_INSTALL_VDD"
                 Action="ResolveLumenVddSelected"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_display_driver = 3"/>
    <SetProperty Id="LUMEN_REMOVE_VDD"
                 Action="ResolveLumenVddRemove"
                 Value="1" After="ResolveLumenVddSelected" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND !CM_C_virtual_display_driver = 3 AND &amp;CM_C_virtual_display_driver = 2"/>
    <SetProperty Id="LUMEN_REMOVE_VDD"
                 Action="ResolveLumenVddKeep"
                 Value="0" After="ResolveLumenVddRemove" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND NOT (!CM_C_virtual_display_driver = 3 AND &amp;CM_C_virtual_display_driver = 2)"/>
    <SetProperty Id="LUMEN_INSTALL_VDD"
                 Action="ResolveLumenVddDeselected"
                 Value="0" After="ResolveLumenVddSelected" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_display_driver &lt;&gt; 3"/>
    <SetProperty Id="LUMEN_INSTALL_VDD"
                 Action="ResolveLumenVddInstalled"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_display_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VDD"
                 Action="ResolveLumenVddNotInstalled"
                 Value="0" After="ResolveLumenVddInstalled" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_display_driver &lt;&gt; 3"/>
    <!-- LUMEN_VDD_FEATURE_END -->

    <!-- Service installation/removal remains in MSI service tables. These two
         actions select the declaratively installed service's start mode. -->
    <CustomAction Id="CA_LumenServiceAutoStart"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; config LumenService start= auto"
                  Execute="deferred" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_LumenServiceDemandStart"
                  Directory="System64Folder"
                  ExeCommand="&quot;[System64Folder]sc.exe&quot; config LumenService start= demand"
                  Execute="deferred" Return="check" Impersonate="no"/>

    <!-- MSI service ownership is declarative above. WixQuietExec is used here
         because deferred EXE custom actions cannot expand CustomActionData in
         their command line. Each matching SetProperty below supplies the full,
         already-formatted command to the deferred action. -->
    <CustomAction Id="CA_LumenInstallRollback"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="rollback" Return="ignore" Impersonate="no"/>
    <CustomAction Id="CA_LumenInstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_LumenInstallCommit"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="commit" Return="check" Impersonate="no"/>

    <CustomAction Id="CA_LumenUninstallRollback"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="rollback" Return="ignore" Impersonate="no"/>
    <CustomAction Id="CA_LumenUninstall"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="deferred" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_LumenUninstallCommit"
                  BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)"
                  DllEntry="WixQuietExec64"
                  Execute="commit" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_LumenReadPendingDriverReboot"
                  BinaryRef="LumenMsiCA"
                  DllEntry="LumenReadPendingDriverReboot"
                  Execute="immediate" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_LumenResolveUpgradeVddOwnership"
                  BinaryRef="LumenMsiCA"
                  DllEntry="LumenResolveUpgradeVddOwnership"
                  Execute="immediate" Return="check" Impersonate="no"/>

    <InstallExecuteSequence>
      <Custom Action="CA_LumenResolveUpgradeVddOwnership" After="CostFinalize"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
      <!-- Each setter has the deferred action's Id so WixQuietExec receives the
           full formatted command through that action's CustomActionData. -->
      <Custom Action="CA_LumenInstallRollback" After="SetLumenInstallCommitData"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
      <Custom Action="CA_LumenInstall" After="CA_LumenInstallRollback"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
      <Custom Action="CA_LumenInstallCommit" After="CA_LumenInstall"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>

      <Custom Action="CA_LumenServiceAutoStart" After="InstallServices"
              Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_autostart = 3"/>
      <Custom Action="CA_LumenServiceDemandStart" After="InstallServices"
              Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_autostart &lt;&gt; 3"/>

      <Custom Action="CA_LumenUninstallRollback" After="SetLumenUninstallCommitData"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CA_LumenUninstall" After="CA_LumenUninstallRollback"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CA_LumenUninstallCommit" After="CA_LumenUninstall"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CA_LumenReadPendingDriverReboot" After="InstallExecute"/>
      <ScheduleReboot Before="InstallFinalize"
                      Condition="LUMEN_DRIVER_REBOOT_REQUIRED = 1"/>
    </InstallExecuteSequence>

    <Feature Id="RunLumenInstallScripts" Title="Run Lumen Installation Scripts" Level="1" Display="hidden">
      <ComponentRef Id="ApplicationShortcutRoot"/>
      <ComponentRef Id="ApplicationShortcut"/>
      <ComponentRef Id="DocumentationShortcut"/>
      <ComponentRef Id="WebsiteShortcut"/>
      <ComponentRef Id="SupportShortcut"/>
    </Feature>

    <SetProperty Id="CA_LumenInstallRollback"
                 Action="SetLumenInstallRollbackData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\lumen-setup.ps1&quot; -Action rollback -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind install -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay [LUMEN_UPGRADE_OWNED_VDD] -UpgradeVddOwnerProduct &quot;[LUMEN_UPGRADE_VDD_OWNER_PRODUCT]&quot;"
                 After="InstallFiles" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_LumenInstall"
                 Action="SetLumenInstallData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\lumen-setup.ps1&quot; -Action install -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind install -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay [LUMEN_UPGRADE_OWNED_VDD] -UpgradeVddOwnerProduct &quot;[LUMEN_UPGRADE_VDD_OWNER_PRODUCT]&quot;"
                 After="SetLumenInstallRollbackData" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_LumenInstallCommit"
                 Action="SetLumenInstallCommitData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\lumen-setup.ps1&quot; -Action commit -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind install -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay [LUMEN_UPGRADE_OWNED_VDD] -UpgradeVddOwnerProduct &quot;[LUMEN_UPGRADE_VDD_OWNER_PRODUCT]&quot;"
                 After="SetLumenInstallData" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_LumenUninstallRollback"
                 Action="SetLumenUninstallRollbackData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\lumen-setup.ps1&quot; -Action rollback -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind uninstall -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay 0 -UpgradeVddOwnerProduct &quot;&quot;"
                 After="StopServices" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <SetProperty Id="CA_LumenUninstall"
                 Action="SetLumenUninstallData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\lumen-setup.ps1&quot; -Action uninstall -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind uninstall -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay 0 -UpgradeVddOwnerProduct &quot;&quot;"
                 After="SetLumenUninstallRollbackData" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <SetProperty Id="CA_LumenUninstallCommit"
                 Action="SetLumenUninstallCommitData"
                 Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[CommonAppDataFolder]LumenVirtualHidInstallerV2\[ProductCode]\uninstall\lumen-setup.ps1&quot; -Action commit -Silent -Msi -ProductCode &quot;[ProductCode]&quot; -TransactionKind uninstall -InstallVirtualHid [LUMEN_INSTALL_VHID] -InstallVirtualMicrophone [LUMEN_INSTALL_VMIC] -InstallVirtualDisplay [LUMEN_INSTALL_VDD] -RemoveVirtualDisplay [LUMEN_REMOVE_VDD] -UpgradeOwnedVirtualDisplay 0 -UpgradeVddOwnerProduct &quot;&quot;"
                 After="SetLumenUninstallData" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
  </Fragment>
</Wix>
