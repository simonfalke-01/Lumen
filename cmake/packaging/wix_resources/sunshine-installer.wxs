<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
  <Fragment>
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ApplicationShortcutRoot" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcutRoot"
                  Name="Sunshine"
                  Description="Sunshine Game Stream Host"
                  Target="[INSTALL_ROOT]sunshine.exe"
                  Arguments="--shortcut"
                  WorkingDirectory="INSTALL_ROOT"/>
        <RegistryValue Root="HKCU" Key="Software\LizardByte\Sunshine" Name="installed_root" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
      <Directory Id="ProgramMenuSubfolder" Name="LizardByte">
        <Directory Id="ProgramMenuSunshineFolder" Name="Sunshine">
          <Component Id="ApplicationShortcut" Guid="*">
            <Shortcut Id="ApplicationStartMenuShortcut"
                      Name="Sunshine"
                      Description="Sunshine Game Stream Host"
                      Target="[INSTALL_ROOT]sunshine.exe"
                      Arguments="--shortcut"
                      WorkingDirectory="INSTALL_ROOT"/>
            <RemoveFolder Id="CleanUpShortCut" Directory="ProgramMenuSunshineFolder" On="uninstall"/>
            <RemoveFolder Id="CleanUpShortCutParent" Directory="ProgramMenuSubfolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\LizardByte\Sunshine" Name="installed" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="DocumentationShortcut" Guid="*">
            <util:InternetShortcut Id="DocumentationLink"
                                   Name="Sunshine Documentation"
                                   Target="https://docs.lizardbyte.dev/projects/sunshine"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpDocsShortCut" Directory="ProgramMenuSunshineFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\LizardByte\Sunshine" Name="docs_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="WebsiteShortcut" Guid="*">
            <util:InternetShortcut Id="WebsiteLink"
                                   Name="LizardByte Web Site"
                                   Target="https://app.lizardbyte.dev"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpWebsiteShortCut" Directory="ProgramMenuSunshineFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\LizardByte\Sunshine" Name="website_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
          <Component Id="SupportShortcut" Guid="*">
            <util:InternetShortcut Id="SupportLink"
                                   Name="LizardByte Support"
                                   Target="https://app.lizardbyte.dev/support"
                                   Type="url"/>
            <RemoveFolder Id="CleanUpSupportShortCut" Directory="ProgramMenuSunshineFolder" On="uninstall"/>
            <RegistryValue Root="HKCU" Key="Software\LizardByte\Sunshine" Name="support_shortcut" Type="integer" Value="1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <Property Id="LUMEN_INSTALL_VHID" Value="1" Secure="yes"/>

    <!-- Normalize the public silent-install property to the actual feature
         action/current state before building deferred CustomActionData. -->
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidSelected"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_hid_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidDeselected"
                 Value="0" After="ResolveLumenVhidSelected" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_virtual_hid_driver &lt;&gt; 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidInstalled"
                 Value="1" After="CostFinalize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_hid_driver = 3"/>
    <SetProperty Id="LUMEN_INSTALL_VHID"
                 Action="ResolveLumenVhidNotInstalled"
                 Value="0" After="ResolveLumenVhidInstalled" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND !CM_C_virtual_hid_driver &lt;&gt; 3"/>

    <!-- Service installation/removal remains in MSI service tables. These two
         actions select the declaratively installed service's start mode. -->
    <CustomAction Id="CA_SunshineServiceAutoStart"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; config SunshineService start= auto"
                  Execute="deferred" Return="check" Impersonate="no"/>
    <CustomAction Id="CA_SunshineServiceDemandStart"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]sc.exe&quot; config SunshineService start= demand"
                  Execute="deferred" Return="check" Impersonate="no"/>

    <!-- MSI service ownership is declarative above. These transaction actions
         retain NSIS-independent path, firewall, migration, and optional-driver work. -->
    <CustomAction Id="CA_SunshineInstallRollback"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action rollback -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="rollback" Return="ignore" Impersonate="no" HideTarget="yes"/>
    <CustomAction Id="CA_SunshineInstall"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action install -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="deferred" Return="check" Impersonate="no" HideTarget="yes"/>
    <CustomAction Id="CA_SunshineInstallCommit"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action commit -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="commit" Return="check" Impersonate="no" HideTarget="yes"/>

    <CustomAction Id="CA_SunshineUninstallRollback"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action rollback -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="rollback" Return="ignore" Impersonate="no" HideTarget="yes"/>
    <CustomAction Id="CA_SunshineUninstall"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action uninstall -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="deferred" Return="check" Impersonate="no" HideTarget="yes"/>
    <CustomAction Id="CA_SunshineUninstallCommit"
                  Directory="SystemFolder"
                  ExeCommand="&quot;[SystemFolder]WindowsPowerShell\v1.0\powershell.exe&quot; -WindowStyle Hidden -NoProfile -NonInteractive -ExecutionPolicy Bypass -File &quot;[INSTALL_ROOT]scripts\sunshine-setup.ps1&quot; -Action commit -Silent -Msi -MsiData &quot;[CustomActionData]&quot;"
                  Execute="commit" Return="check" Impersonate="no" HideTarget="yes"/>

    <InstallExecuteSequence>
      <!-- Each setter has the deferred action's Id so Windows Installer copies
           the formatted value into that action's CustomActionData property. -->
      <Custom Action="CA_SunshineInstallRollback" After="SetSunshineInstallCommitData"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
      <Custom Action="CA_SunshineInstall" After="CA_SunshineInstallRollback"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
      <Custom Action="CA_SunshineInstallCommit" After="CA_SunshineInstall"
              Condition="NOT (REMOVE=&quot;ALL&quot;)"/>

      <Custom Action="CA_SunshineServiceAutoStart" After="InstallServices"
              Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_autostart = 3"/>
      <Custom Action="CA_SunshineServiceDemandStart" After="InstallServices"
              Condition="NOT (REMOVE=&quot;ALL&quot;) AND &amp;CM_C_autostart &lt;&gt; 3"/>

      <Custom Action="CA_SunshineUninstallRollback" After="SetSunshineUninstallCommitData"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CA_SunshineUninstall" After="CA_SunshineUninstallRollback"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
      <Custom Action="CA_SunshineUninstallCommit" After="CA_SunshineUninstall"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    </InstallExecuteSequence>

    <Feature Id="RunSunshineInstallScripts" Title="Run Sunshine Installation Scripts" Level="1" Display="hidden">
      <ComponentRef Id="ApplicationShortcutRoot"/>
      <ComponentRef Id="ApplicationShortcut"/>
      <ComponentRef Id="DocumentationShortcut"/>
      <ComponentRef Id="WebsiteShortcut"/>
      <ComponentRef Id="SupportShortcut"/>
    </Feature>

    <SetProperty Id="CA_SunshineInstallRollback"
                 Action="SetSunshineInstallRollbackData"
                 Value="1|[ProductCode]|install|[LUMEN_INSTALL_VHID]"
                 After="InstallFiles" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_SunshineInstall"
                 Action="SetSunshineInstallData"
                 Value="1|[ProductCode]|install|[LUMEN_INSTALL_VHID]"
                 After="SetSunshineInstallRollbackData" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_SunshineInstallCommit"
                 Action="SetSunshineInstallCommitData"
                 Value="1|[ProductCode]|install|[LUMEN_INSTALL_VHID]"
                 After="SetSunshineInstallData" Sequence="execute"
                 Condition="NOT (REMOVE=&quot;ALL&quot;)"/>
    <SetProperty Id="CA_SunshineUninstallRollback"
                 Action="SetSunshineUninstallRollbackData"
                 Value="1|[ProductCode]|uninstall|[LUMEN_INSTALL_VHID]"
                 After="InstallInitialize" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <SetProperty Id="CA_SunshineUninstall"
                 Action="SetSunshineUninstallData"
                 Value="1|[ProductCode]|uninstall|[LUMEN_INSTALL_VHID]"
                 After="SetSunshineUninstallRollbackData" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
    <SetProperty Id="CA_SunshineUninstallCommit"
                 Action="SetSunshineUninstallCommitData"
                 Value="1|[ProductCode]|uninstall|[LUMEN_INSTALL_VHID]"
                 After="SetSunshineUninstallData" Sequence="execute"
                 Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE"/>
  </Fragment>
</Wix>
