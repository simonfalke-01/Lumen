if (WIN32)
elseif (APPLE)
    if (NOT LUMEN_BUILD_HOMEBREW)
        set(CMAKE_BUILD_WITH_INSTALL_RPATH ON)
        set(CMAKE_INSTALL_RPATH "")
        set(CMAKE_INSTALL_RPATH_USE_LINK_PATH FALSE)
    endif()
elseif (UNIX)
    include(GNUInstallDirs)

    if(NOT DEFINED LUMEN_EXECUTABLE_PATH)
        set(LUMEN_EXECUTABLE_PATH "lumen")
    endif()

    if(LUMEN_BUILD_FLATPAK)
        set(LUMEN_SERVICE_START_COMMAND "ExecStart=flatpak run --command=lumen ${PROJECT_FQDN}")
        set(LUMEN_SERVICE_STOP_COMMAND "ExecStop=flatpak kill ${PROJECT_FQDN}")
    else()
        set(LUMEN_SERVICE_START_COMMAND "ExecStart=${LUMEN_EXECUTABLE_PATH}")
        set(LUMEN_SERVICE_STOP_COMMAND "")
    endif()
endif()
