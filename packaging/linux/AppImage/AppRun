#!/bin/bash

# custom AppRun for Lumen AppImage

# path of the extracted AppRun
HERE="$(dirname "$(readlink -f "${0}")")"
LUMEN_PATH=/usr/bin/lumen
LUMEN_BIN_HERE=$HERE/usr/bin/lumen
LUMEN_SHARE_HERE=$HERE/usr/share/lumen

# Set APPDIR when running directly from the AppDir:
if [ -z "$APPDIR" ]; then
    ARGV0="AppRun"
fi

cd "$HERE" || exit 1

function help() {
echo "
 ------------------------------
   Lumen AppImage package.
 ------------------------------

 Lumen.AppImage options
 ------------------------

 Usage:  $ARGV0  --help, -h
 ------            # This message

         $ARGV0  --install, -i
                   # Install input rules and Lumen service files. Restart required.

         $ARGV0  --remove, -r
                   # Remove input rules and Lumen service files.

         $ARGV0  --appimage-help
                   # Show available AppImage options

 Lumen options
 ----------------
"
# print Lumen binary help, replacing the binary path in the usage statement
"$LUMEN_BIN_HERE" --help | sed -e "s#$LUMEN_BIN_HERE#$ARGV0#g"
}

function install() {
  # user input rules
  # shellcheck disable=SC2002
  cat "$LUMEN_SHARE_HERE/udev/rules.d/60-lumen.rules" | sudo tee /etc/udev/rules.d/60-lumen.rules
  cat "$LUMEN_SHARE_HERE/modules-load.d/60-lumen.conf" | sudo tee /etc/modules-load.d/60-lumen.conf
  sudo modprobe uhid
  sudo udevadm control --reload-rules
  sudo udevadm trigger --property-match=DEVNAME=/dev/uinput
  sudo udevadm trigger --property-match=DEVNAME=/dev/uhid

  # Lumen service
  mkdir -p ~/.config/systemd/user
  cp -r "$LUMEN_SHARE_HERE/systemd/user/" ~/.config/systemd/
  # patch service executable path
  sed -i -e "s#$LUMEN_PATH#$(readlink -f "$ARGV0")#g" ~/.config/systemd/user/app-io.github.simonfalke.Lumen.service

  # setcap
  sudo setcap cap_sys_admin,cap_sys_nice+p "$(readlink -f "$LUMEN_BIN_HERE")"
}

function remove() {
  # remove input rules
  sudo rm -f /etc/udev/rules.d/60-lumen.rules

  # remove uhid module loading config
  sudo rm -f /etc/modules-load.d/60-lumen.conf

  # remove service
  sudo rm -f ~/.config/systemd/user/app-io.github.simonfalke.Lumen.service
}

# process arguments
case "${1:-}" in
  help|--help|-h)
    help
    exit $?
    ;;
  install|--install|-i)
    install
    exit $?
    ;;
  remove|--remove|-r)
    remove
    exit $?
    ;;
esac

# Lumen owns its staged, symlink-safe legacy configuration import.
"$LUMEN_BIN_HERE" "$@"
