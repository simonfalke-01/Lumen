; Lumen root-enumerated UMDF 2 HID minidriver.

[Version]
Signature = "$WINDOWS NT$"
Class = HIDClass
ClassGuid = {745a17a0-74d3-11d0-b6fe-00a0c90f57da}
Provider = %LumenProvider%
DriverVer = 08/12/2026,1.0.0.0
CatalogFile = LumenVirtualHid.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %InstallationMedia%,,,

[SourceDisksFiles]
LumenVirtualHid.dll = 1

[Manufacturer]
%LumenProvider% = LumenVirtualHid.Models, NTamd64.10.0...22000

[LumenVirtualHid.Models.NTamd64.10.0...22000]
%LumenVirtualHid.DeviceDesc% = LumenVirtualHid.Install, ROOT\LumenVirtualHid

[LumenVirtualHid.Install.NT]
CopyFiles = LumenVirtualHid.CopyFiles
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT

[LumenVirtualHid.Install.NT.HW]
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT.HW
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.HW

[LumenVirtualHid.Install.NT.Services]
Include = MsHidUmdf.inf
Needs = MsHidUmdf.NT.Services
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.Services

[LumenVirtualHid.Install.NT.Filters]
Include = WUDFRD.inf
Needs = WUDFRD_LowerFilter.NT.Filters

[LumenVirtualHid.Install.NT.Wdf]
UmdfService = "LumenVirtualHid", LumenVirtualHid.Wdf
UmdfServiceOrder = LumenVirtualHid
UmdfKernelModeClientPolicy = AllowKernelModeClients
UmdfFileObjectPolicy = AllowNullAndUnknownFileObjects
UmdfMethodNeitherAction = Copy
UmdfFsContextUsePolicy = CanUseFsContext2

[LumenVirtualHid.Wdf]
UmdfLibraryVersion = $UMDFVERSION$
ServiceBinary = "%13%\LumenVirtualHid.dll"

[LumenVirtualHid.CopyFiles]
LumenVirtualHid.dll

[Strings]
LumenProvider = "LizardByte"
InstallationMedia = "Lumen Virtual HID installation media"
LumenVirtualHid.DeviceDesc = "Lumen Virtual HID Keyboard and Mouse"
